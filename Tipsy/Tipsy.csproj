<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.0.0</Version>
    <Author>Anthony Perez</Author>
    <Name>Tipsy</Name>
    <Punchline>Themeable replacements for the game's tooltips.</Punchline>
    <Description>Tipsy replaces the game's item, action and text tooltips with one themeable window. Pin it to a corner, a spot of your own or your cursor, pick a theme or your own colours, and keep the lines other plugins add.</Description>
    <RepoUrl>https://github.com/AntPerez69367/ffxiv_tipsy</RepoUrl>
    <Tags>tooltip;ui;items;actions;theme</Tags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TipsyProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);TIPSY_PROBE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tipsy.Core\Tipsy.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
